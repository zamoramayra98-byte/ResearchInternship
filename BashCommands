#!/bin/bash

# ====================================================
# Multi-session ICA Pipeline
# ====================================================

set -e


# ----------------------------------------------------
# 1. Define directories
# ----------------------------------------------------

DATA_DIR="/path/to/data"
OUTPUT_DIR="/path/to/output"


# ----------------------------------------------------
# 2. Define subjects and sessions
# ----------------------------------------------------

subjects=("P01" "P02" "P03")

sessions=("S1" "S2" "S3" "S4" "S5" "S6" "S7" "S8")


# ----------------------------------------------------
# 3. Loop through each subject
# ----------------------------------------------------

for subject in "${subjects[@]}"
do

    echo "Processing ${subject}"

    # Create output directory for subject
    subject_out="${OUTPUT_DIR}/${subject}"

    mkdir -p "${subject_out}"


    # ------------------------------------------------
    # 4. Create an empty list for functional files
    # ------------------------------------------------

    func_list=()

    mask=""


    # ------------------------------------------------
    # 5. Loop through each session
    # ------------------------------------------------

    for session in "${sessions[@]}"
    do

        # Location of functional image
        func="${DATA_DIR}/${subject}/${session}/func.nii.gz"

        # Location of brain mask
        session_mask="${DATA_DIR}/${subject}/${session}/mask.nii.gz"


        # --------------------------------------------
        # Check whether functional image exists
        # --------------------------------------------

        if [ ! -f "$func" ]; then

            echo "Missing functional image:"
            echo "$func"

            continue

        fi


        # Add functional image to the list
        func_list+=("$func")


        # --------------------------------------------
        # Find a brain mask
        # --------------------------------------------

        if [ -z "$mask" ] && [ -f "$session_mask" ]; then

            mask="$session_mask"

        fi

    done


    # ------------------------------------------------
    # 6. Check number of sessions
    # ------------------------------------------------

    if [ ${#func_list[@]} -lt 2 ]; then

        echo "Not enough sessions."

        continue

    fi


    # ------------------------------------------------
    # 7. Check that a mask was found
    # ------------------------------------------------

    if [ -z "$mask" ]; then

        echo "No brain mask found for ${subject}."

        continue

    fi


    # ------------------------------------------------
    # 8. Concatenate sessions
    # ------------------------------------------------

    concatenated="${subject_out}/concatenated_func.nii.gz"

    echo "Concatenating sessions..."


    # Get TR from the first functional image
    TR=$(fslval "${func_list[0]}" pixdim4)


    # Combine sessions in the time dimension
    # and preserve the correct TR
    fslmerge -tr \
        "$concatenated" \
        "${func_list[@]}" \
        "$TR"


    # ------------------------------------------------
    # 9. Run MELODIC
    # ------------------------------------------------

    echo "Running MELODIC..."


    melodic \
        -i "$concatenated" \
        -o "${subject_out}/melodic" \
        -m "$mask" \
        --report \
        --nobet


    echo "Finished ${subject}"


done


# ----------------------------------------------------
# 10. Pipeline complete
# ----------------------------------------------------

echo "Pipeline complete."
