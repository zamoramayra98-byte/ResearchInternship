
#!/usr/bin/env python3

from pathlib import Path
import shutil
import subprocess

import nibabel as nib
import numpy as np
import pandas as pd
from scipy.interpolate import interp1d


# ============================================================
# 1. SETTINGS
# ============================================================

# Original fMRI sampling interval: TR = 1.5 seconds
ICA_FREQ = 1 / 1.5

# Target sampling interval: 0.5 seconds
TARGET_FREQ = 1 / 0.5

# Number of components requested in the MELODIC pipeline
NUMBER_COMPONENTS = 20


# ============================================================
# 2. DIRECTORIES
# ============================================================

BASE_DIRECTORY = Path(
    "/data/M3PI/derivatives/Mayra_derivatives/vessels_melodic"
)

VESSEL_DIRECTORY = Path(
    "/data/vessels"
)

NETWORK_DIRECTORY = Path(
    "/data/func_net_comp"
)


# ============================================================
# 3. LOAD NETWORK MASKS
# ============================================================

def load_network_masks(subject):
    """
    Find the available network masks for a subject.

    Prefer masks already transformed to vessel-reference space.
    """

    masks = sorted(
        NETWORK_DIRECTORY.glob(
            f"map_*_mask_{subject}_vesselres.nii.gz"
        )
    )

    # Fall back to masks in their original space if no
    # vessel-reference masks are available.
    if not masks:
        masks = sorted(
            NETWORK_DIRECTORY.glob(
                f"map_*_mask_{subject}.nii.gz"
            )
        )

        # Exclude vessel-reference outputs from the fallback.
        masks = [
            mask for mask in masks
            if not mask.name.endswith("_vesselres.nii.gz")
        ]

    return masks


# ============================================================
# 4. LOAD ICA TIME SERIES
# ============================================================

def load_ica_time_series(melodic_directory):
    """
    Load the MELODIC component time series from melodic_mix.

    Expected shape: time points x components.
    """

    mix_file = Path(melodic_directory) / "melodic_mix"

    if not mix_file.exists():
        raise FileNotFoundError(
            f"ICA time-series file not found: {mix_file}"
        )

    time_series = np.loadtxt(mix_file)

    # Handle a single-component file.
    if time_series.ndim == 1:
        time_series = time_series[:, np.newaxis]

    if time_series.ndim != 2:
        raise ValueError(
            f"Unexpected melodic_mix shape: {time_series.shape}"
        )

    print("Original ICA time-series shape:", time_series.shape)

    return time_series


# ============================================================
# 5. RESAMPLE ICA TIME SERIES
# ============================================================

def resample_signal_freqs(
    ts,
    freq1=ICA_FREQ,
    freq2=TARGET_FREQ,
    axis=0
):
    """
    Interpolate a signal from freq1 to freq2.

    For this analysis:
        freq1 = 1 / 1.5 Hz
        freq2 = 1 / 0.5 Hz

    The original time points are retained as reference points.
    New points are interpolated between them.
    """

    ts = np.asarray(ts, dtype=float)

    if freq1 <= 0 or freq2 <= 0:
        raise ValueError(
            "Sampling frequencies must be positive."
        )

    if ts.ndim == 0:
        raise ValueError("The input must be a time series.")

    if ts.shape[axis] < 2:
        raise ValueError(
            "At least two time points are needed for interpolation."
        )

    n_original = ts.shape[axis]

    # Original time points in seconds.
    original_times = np.arange(n_original) / freq1

    # Target time points at 0.5-second intervals.
    n_target = int(round((n_original - 1) * freq2 / freq1)) + 1

    target_times = np.arange(n_target) / freq2

    interpolator = interp1d(
        original_times,
        ts,
        axis=axis,
        kind="linear",
        bounds_error=True
    )

    resampled = interpolator(target_times)

    print("Original sampling frequency:", freq1, "Hz")
    print("Target sampling frequency:", freq2, "Hz")
    print("Original time points:", n_original)
    print("Resampled time points:", resampled.shape[axis])
    print("Original duration:", original_times[-1], "seconds")
    print("Target interval:", 1 / freq2, "seconds")

    return resampled, target_times


# ============================================================
# 6. TRANSFORM NETWORK MASKS WITH ANTs
# ============================================================

def transform_network_masks(subject):
    """
    Transform the subject's network masks into vessel-reference
    space, if the required files and ANTs are available.

    Existing vessel-reference masks are not transformed again.
    """

    subject_number = subject.replace("sub-", "")

    anat_reference = (
        VESSEL_DIRECTORY
        / f"sub-{subject_number}"
        / "ses-7T/reg"
        / f"sub-{subject_number}_vesselref.nii.gz"
    )

    t1w_to_t2starw = (
        VESSEL_DIRECTORY
        / f"sub-{subject_number}"
        / "ses-7T/reg"
        / f"sub-{subject_number}_ses-02_UNIT12vesselref0GenericAffine.mat"
    )

    t2w_to_t1w = (
        VESSEL_DIRECTORY
        / f"sub-{subject_number}"
        / "ses-02/reg"
        / f"sub-{subject_number}_ses-02_T2w2UNIT10GenericAffine.mat"
    )

    t2w_to_func = (
        VESSEL_DIRECTORY
        / f"sub-{subject_number}"
        / "ses-01/reg"
        / f"sub-{subject_number}_ses-02_T2w2sbref0GenericAffine.mat"
    )

    required_files = [
        anat_reference,
        t1w_to_t2starw,
        t2w_to_t1w,
        t2w_to_func
    ]

    missing_files = [
        file for file in required_files
        if not file.exists()
    ]

    if missing_files:
        print(
            f"WARNING: Cannot transform masks for {subject}. "
            "Required registration files are missing:"
        )

        for file in missing_files:
            print("  ", file)

        return

    if shutil.which("antsApplyTransforms") is None:
        print(
            "WARNING: antsApplyTransforms is unavailable. "
            "Run inside an ANTs-enabled container."
        )
        return

    input_masks = sorted(
        NETWORK_DIRECTORY.glob(
            f"map_*_mask_{subject}.nii.gz"
        )
    )

    input_masks = [
        mask for mask in input_masks
        if not mask.name.endswith("_vesselres.nii.gz")
    ]

    if not input_masks:
        print(f"No original network masks found for {subject}.")
        return

    for input_mask in input_masks:

        output_mask = input_mask.with_name(
            f"{input_mask.name[:-7]}_vesselres.nii.gz"
        )

        if output_mask.exists():
            print(f"Already transformed: {output_mask.name}")
            continue

        command = [
            "antsApplyTransforms",
            "-d", "3",
            "-i", str(input_mask),
            "-r", str(anat_reference),
            "-o", str(output_mask),
            "-n", "NearestNeighbor",
            "-t", str(t1w_to_t2starw),
            "-t", str(t2w_to_t1w),
            "-t", f"[{t2w_to_func},1]"
        ]

        print(f"Transforming mask: {input_mask.name}")

        try:
            subprocess.run(command, check=True)
            print(f"Created: {output_mask}")

        except subprocess.CalledProcessError as error:
            print(
                f"ERROR transforming {input_mask.name}: {error}"
            )


# ============================================================
# 7. INSPECT NETWORK MASKS
# ============================================================

def inspect_network_masks(subject, output_directory):
    """
    Load each network mask and save basic spatial information.

    This function does not load melodic_IC.nii.gz.
    """

    masks = load_network_masks(subject)

    if not masks:
        print(f"No network masks found for {subject}.")
        return

    mask_results = []

    for mask_file in masks:

        print(f"Loading mask: {mask_file.name}")

        mask_image = nib.load(str(mask_file))
        mask_data = mask_image.get_fdata()

        binary_mask = mask_data > 0

        mask_results.append({
            "subject": subject,
            "mask": mask_file.name,
            "shape": str(mask_image.shape),
            "voxel_count": int(np.count_nonzero(binary_mask)),
            "voxel_volume_mm3": float(
                abs(np.linalg.det(mask_image.affine[:3, :3]))
            ),
            "mask_volume_mm3": float(
                np.count_nonzero(binary_mask)
                * abs(np.linalg.det(mask_image.affine[:3, :3]))
            )
        })

        print("  Shape:", mask_image.shape)
        print("  Nonzero voxels:", np.count_nonzero(binary_mask))

    results_file = output_directory / "network_mask_summary.csv"

    pd.DataFrame(mask_results).to_csv(
        results_file,
        index=False
    )

    print("Mask summary saved to:", results_file)


# ============================================================
# 8. PROCESS ONE SUBJECT
# ============================================================

def process_subject(subject):

    print("\n========================================")
    print(f"Processing {subject}")
    print("========================================")

    melodic_directory = (
        BASE_DIRECTORY
        / subject
        / f"{subject}{NUMBER_COMPONENTS}_melodic"
    )

    if not melodic_directory.exists():
        print(
            f"WARNING: MELODIC directory not found: "
            f"{melodic_directory}"
        )
        return

    # Output files are stored alongside melodic_mix.
    output_directory = melodic_directory
    output_directory.mkdir(parents=True, exist_ok=True)

    # A. Transform masks when possible.
    transform_network_masks(subject)

    # B. Load and inspect network masks.
    inspect_network_masks(subject, output_directory)

    # C. Load ICA time series.
    try:
        ica_time_series = load_ica_time_series(
            melodic_directory
        )
    except (FileNotFoundError, ValueError) as error:
        print(f"WARNING: Skipping {subject}: {error}")
        return

    # D. Interpolate ICA time series to 0.5-second intervals.
    resampled_ica, target_times = resample_signal_freqs(
        ica_time_series,
        freq1=1 / 1.5,
        freq2=1 / 0.5,
        axis=0
    )

    # E. Save resampled time series.
    number_components = resampled_ica.shape[1]

    columns = [
        f"component_{i + 1}"
        for i in range(number_components)
    ]

    time_series_df = pd.DataFrame(
        resampled_ica,
        columns=columns
    )

    time_series_df.insert(0, "time_seconds", target_times)

    output_file = (
        output_directory
        / f"{subject}_ICA_timeseries_0.5s.csv"
    )

    time_series_df.to_csv(output_file, index=False)

    print("Resampled ICA shape:", resampled_ica.shape)
    print("Saved resampled time series:", output_file)


# ============================================================
# 9. MAIN: PROCESS ALL SUBJECTS
# ============================================================

def main():

    if not BASE_DIRECTORY.exists():
        raise FileNotFoundError(
            f"MELODIC base directory not found: {BASE_DIRECTORY}"
        )

    subjects = sorted(
        folder.name
        for folder in BASE_DIRECTORY.iterdir()
        if folder.is_dir() and folder.name.startswith("sub-")
    )

    if not subjects:
        print("No subject directories found.")
        return

    print("Subjects found:", subjects)
    print("Original ICA frequency:", ICA_FREQ, "Hz")
    print("Target frequency:", TARGET_FREQ, "Hz")

    for subject in subjects:
        try:
            process_subject(subject)
        except Exception as error:
            print(f"ERROR processing {subject}: {error}")
            continue

    print("\n========================================")
    print("ALL SUBJECTS PROCESSED")
    print("========================================")


if __name__ == "__main__":
    main()

