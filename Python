#!/usr/bin/env python3

from pathlib import Path

import nibabel as nib
import numpy as np
import pandas as pd


# ----------------------------------------
# Load ICA spatial maps
# ----------------------------------------

def load_spatial_maps(melodic_directory):

    maps = nib.load(
        Path(melodic_directory) / "melodic_IC.nii.gz"
    )

    return maps


# ----------------------------------------
# Load ICA time series
# ----------------------------------------

def load_time_series(melodic_directory):

    return np.loadtxt(
        Path(melodic_directory) / "melodic_mix"
    )


# ----------------------------------------
# Load CO2 recording
# ----------------------------------------

def load_co2(file):

    return pd.read_csv(file)

# ----------------------------------------
 # Prepare CO2 signal 
# ---------------------------------------- 
def get_co2_signal(co2): 

    # Display column names so we know what is available 
    print("\nCO2 columns:") 
    print(co2.columns) 

    # Use the first numerical column as the CO2 signal 
    numerical_columns = co2.select_dtypes( 
        include=np.number
     ).columns 

if len(numerical_columns) == 0: 

    raise ValueError( 
        "No numerical CO2 column was found."
     ) 

co2_signal = co2[numerical_columns[0]].to_numpy() 

return co2_signal

# ----------------------------------------
# Align CO2 and ICA time series using cross-correlation
# ----------------------------------------

def match_lengths(ica_time_series, co2_signal):

    n_ica = ica_time_series.shape[0]
    n_co2 = len(co2_signal)

    print("\nNumber of ICA time points:", n_ica)
    print("Number of CO2 time points:", n_co2)

    # ----------------------------------------
    # Prepare signals for cross-correlation
    # ----------------------------------------

    # Use the mean across all ICA components
    # as the reference ICA signal
    ica_reference = np.mean(ica_time_series, axis=1)

    # Remove the mean from both signals
    ica_reference = ica_reference - np.mean(ica_reference)
    co2_signal = co2_signal - np.mean(co2_signal)

    # ----------------------------------------
    # Calculate cross-correlation
    # ----------------------------------------

    correlation = np.correlate(
        ica_reference,
        co2_signal,
        mode="full"
    )

    # Find the lag with the strongest correlation
    lag = np.argmax(correlation) - (n_co2 - 1)

    print("Estimated lag:", lag)

    # ----------------------------------------
    # Shift signals according to the lag
    # ----------------------------------------

    if lag > 0:

        ica_time_series = ica_time_series[lag:, :]

    elif lag < 0:

        co2_signal = co2_signal[-lag:]

    # ----------------------------------------
    # Match lengths after alignment
    # ----------------------------------------

    n = min(
        ica_time_series.shape[0],
        len(co2_signal)
    )

    ica_time_series = ica_time_series[:n, :]
    co2_signal = co2_signal[:n]

    print("Matched number of time points:", n)

    return ica_time_series, co2_signal


# ----------------------------------------
# Correlate ICA components with CO2
# ----------------------------------------

def correlate_components(ica_time_series, co2_signal):

    correlations = []

    number_components = ica_time_series.shape[1]

    for component in range(number_components):

        component_signal = ica_time_series[:, component]

        correlation = np.corrcoef(
            component_signal,
            co2_signal
        )[0, 1]

        correlations.append(correlation)

    return np.array(correlations)


# ----------------------------------------
# Save correlation results
# ----------------------------------------

def save_results(correlations, output_file):

    results = pd.DataFrame({

        "component": np.arange(
            1,
            len(correlations) + 1
        ),

        "correlation_with_CO2": correlations,

        "absolute_correlation": np.abs(
            correlations
        )

    })

    # Sort by absolute correlation
    results = results.sort_values(
        "absolute_correlation",
        ascending=False
    )

    results.to_csv(
        output_file,
        index=False
    )

    return results


# ----------------------------------------
# Main
# ----------------------------------------

def main():

    # ------------------------------------
    # Define directories
    # ------------------------------------

    base_directory = Path(
        "/Neurodata/M3PI/derivatives/Mayra_derivatives/vessels_melodic"
    )

    co2_base_directory = Path(
        "/Neurodata/M3PI/CO2"
    )

    numbercomponents = 20


    # ------------------------------------
    # Find all subjects
    # ------------------------------------

    subjects = sorted(
        folder.name
        for folder in base_directory.iterdir()
        if folder.is_dir() and folder.name.startswith("sub-")
    )


    print("\n====================================")
    print("ICA / CO2 ANALYSIS")
    print("====================================")

    print("\nSubjects found:")
    print(subjects)


    # ------------------------------------
    # Loop through every subject
    # ------------------------------------

    for subject in subjects:

        print("\n\n====================================")
        print(f"Processing {subject}")
        print("====================================")


        # ------------------------------------
        # MELODIC directory
        # ------------------------------------

        melodic_directory = (
            base_directory
            / subject
            / f"{subject}{numbercomponents}_melodic"
        )


        # ------------------------------------
        # CO2 file
        # ------------------------------------

        co2_file = (
            co2_base_directory
            / f"{subject}.csv"
        )


        # ------------------------------------
        # Check MELODIC directory
        # ------------------------------------

        if not melodic_directory.exists():

            print(
                f"\nWARNING: MELODIC directory not found for "
                f"{subject}:"
            )

            print(melodic_directory)

            print("Skipping subject.")

            continue


        # ------------------------------------
        # Check CO2 file
        # ------------------------------------

        if not co2_file.exists():

            print(
                f"\nWARNING: CO2 file not found for "
                f"{subject}:"
            )

            print(co2_file)

            print("Skipping subject.")

            continue


        # ------------------------------------
        # Load ICA spatial maps
        # ------------------------------------

        spatial_maps = load_spatial_maps(
            melodic_directory
        )


        # ------------------------------------
        # Load ICA time series
        # ------------------------------------

        ica_time_series = load_time_series(
            melodic_directory
        )


        # ------------------------------------
        # Load CO2
        # ------------------------------------

        co2 = load_co2(
            co2_file
        )


        # ------------------------------------
        # Print basic information
        # ------------------------------------

        print("\nSubject:")
        print(subject)

        print("\nMELODIC directory:")
        print(melodic_directory)

        print("\nSpatial map shape:")
        print(spatial_maps.shape)

        print("\nICA time series shape:")
        print(ica_time_series.shape)

        print("\nCO2 data:")
        print(co2.head())


        # ------------------------------------
        # Extract CO2 signal
        # ------------------------------------

        co2_signal = get_co2_signal(
            co2
        )


        # ------------------------------------
        # Match ICA and CO2 lengths
        # ------------------------------------

        ica_time_series, co2_signal = match_lengths(
            ica_time_series,
            co2_signal
        )


        # ------------------------------------
        # Calculate correlations
        # ------------------------------------

        correlations = correlate_components(
            ica_time_series,
            co2_signal
        )


        # ------------------------------------
        # Save results
        # ------------------------------------

        output_file = (
            melodic_directory
            / "ICA_CO2_correlations.csv"
        )


        results = save_results(
            correlations,
            output_file
        )


        # ------------------------------------
        # Display results
        # ------------------------------------

        print("\n====================================")
        print(f"ICA COMPONENT / CO2 CORRELATIONS")
        print(f"Subject: {subject}")
        print("====================================")

        print(
            results.to_string(index=False)
        )


        print("\nResults saved to:")
        print(output_file)


    # ------------------------------------
    # Finished
    # ------------------------------------

    print("\n\n====================================")
    print("ALL SUBJECTS COMPLETE")
    print("====================================")
